    <!--
      PC 补全编辑专用：动态 UPDATE 全列带 !=null 条件，无法把可空列清空。
      这里显式 SET 表单拥有的可空列（非本类型列恒为 null，回写无害），
      仅由补全编辑路径调用；出口处理/关闭走 updateProException。
    -->
    <update id="updateExceptionEditOptional" parameterType="com.ruoyi.system.domain.mes.pro.ProException">
        update qxx_pro_exception
        set impact_quantity = #{impactQuantity},
            usable_quantity = #{usableQuantity},
            expected_arrival_date = #{expectedArrivalDate},
            remark = #{remark}
        where exception_id = #{exceptionId}
    </update>

    <!-- 未关闭=待处理+处理中；已关闭/已作废均不硬拦完工（VOID 见 V158） -->
    <select id="selectOpenByWorkorderId" resultMap="ProExceptionResult">
        <include refid="selectProExceptionVo"/>
        where workorder_id = #{workorderId}
          and status in ('OPEN', 'PROCESSING')
        order by occur_time asc, exception_id asc
    </select>

    <select id="selectOpenByWorkorderIds" resultMap="ProExceptionResult">
        <include refid="selectProExceptionVo"/>
        where status in ('OPEN', 'PROCESSING')
          and workorder_id in
        <foreach collection="workorderIds" item="wid" open="(" separator="," close=")">
            #{wid}
        </foreach>
        order by occur_time asc, exception_id asc
    </select>

    <!-- -E 序号计数：同原任务下异常(返工/补做)任务数 -->
    <select id="countExceptionTasksByOrigin" resultType="int">
        select count(*) from qxx_pro_task
        where origin_task_id = #{originTaskId}
          and is_exception = 'Y'
    </select>

