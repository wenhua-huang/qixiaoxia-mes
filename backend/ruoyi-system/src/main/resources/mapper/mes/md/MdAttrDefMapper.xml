<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.mes.md.MdAttrDefMapper">

    <resultMap type="com.ruoyi.system.domain.mes.md.MdAttrDef" id="MdAttrDefResult">
        <result property="attrId"       column="attr_id"       />
        <result property="factoryId"    column="factory_id"    />
        <result property="attrCode"     column="attr_code"     />
        <result property="attrName"     column="attr_name"     />
        <result property="attrType"     column="attr_type"     />
        <result property="attrUnit"     column="attr_unit"     />
        <result property="optionsJson"  column="options_json_str" />
        <result property="sortOrder"    column="sort_order"    />
        <result property="enableFlag"   column="enable_flag"   />
        <result property="remark"       column="remark"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
    </resultMap>

    <sql id="selectMdAttrDefVo">
        select attr_id, factory_id, attr_code, attr_name, attr_type, attr_unit,
               CAST(options_json AS CHAR) as options_json_str,
               sort_order, enable_flag, remark, create_by, create_time, update_by, update_time
          from qxx_md_attr_def
    </sql>

    <!-- attr_def 全局表(factory_id=0)，不走 FactoryIdInterceptor 隔离，查询不加 factory_id 条件 -->
    <select id="selectMdAttrDefList" parameterType="com.ruoyi.system.domain.mes.md.MdAttrDef" resultMap="MdAttrDefResult">
        <include refid="selectMdAttrDefVo"/>
        <where>
            <if test="attrCode != null and attrCode != ''"> and attr_code like concat('%', #{attrCode}, '%')</if>
            <if test="attrName != null and attrName != ''"> and attr_name like concat('%', #{attrName}, '%')</if>
            <if test="attrType != null and attrType != ''"> and attr_type = #{attrType}</if>
            <if test="enableFlag != null and enableFlag != ''"> and enable_flag = #{enableFlag}</if>
        </where>
        order by sort_order, attr_id
    </select>

    <select id="selectMdAttrDefByAttrId" parameterType="Long" resultMap="MdAttrDefResult">
        <include refid="selectMdAttrDefVo"/>
        where attr_id = #{attrId}
    </select>

    <select id="checkAttrCodeUnique" parameterType="com.ruoyi.system.domain.mes.md.MdAttrDef" resultMap="MdAttrDefResult">
        <include refid="selectMdAttrDefVo"/>
        where attr_code = #{attrCode} limit 1
    </select>

    <insert id="insertMdAttrDef" parameterType="com.ruoyi.system.domain.mes.md.MdAttrDef" useGeneratedKeys="true" keyProperty="attrId">
        insert into qxx_md_attr_def
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="factoryId != null">factory_id,</if>
            <if test="attrCode != null and attrCode != ''">attr_code,</if>
            <if test="attrName != null and attrName != ''">attr_name,</if>
            <if test="attrType != null and attrType != ''">attr_type,</if>
            <if test="attrUnit != null">attr_unit,</if>
            <if test="optionsJson != null">options_json,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="factoryId != null">#{factoryId},</if>
            <if test="attrCode != null and attrCode != ''">#{attrCode},</if>
            <if test="attrName != null and attrName != ''">#{attrName},</if>
            <if test="attrType != null and attrType != ''">#{attrType},</if>
            <if test="attrUnit != null">#{attrUnit},</if>
            <if test="optionsJson != null">#{optionsJson},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="enableFlag != null and enableFlag != ''">#{enableFlag},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateMdAttrDef" parameterType="com.ruoyi.system.domain.mes.md.MdAttrDef">
        update qxx_md_attr_def
        <trim prefix="SET" suffixOverrides=",">
            <if test="attrCode != null and attrCode != ''">attr_code = #{attrCode},</if>
            <if test="attrName != null and attrName != ''">attr_name = #{attrName},</if>
            <if test="attrType != null and attrType != ''">attr_type = #{attrType},</if>
            <if test="attrUnit != null">attr_unit = #{attrUnit},</if>
            <if test="optionsJson != null">options_json = #{optionsJson},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="enableFlag != null and enableFlag != ''">enable_flag = #{enableFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where attr_id = #{attrId}
    </update>

    <delete id="deleteMdAttrDefByAttrId" parameterType="Long">
        delete from qxx_md_attr_def where attr_id = #{attrId}
    </delete>

    <delete id="deleteMdAttrDefByAttrIds" parameterType="String">
        delete from qxx_md_attr_def where attr_id in
        <foreach item="attrId" collection="array" open="(" separator="," close=")">
            #{attrId}
        </foreach>
    </delete>

</mapper>
