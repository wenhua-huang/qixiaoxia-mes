    <sql id="selectProExceptionVo">
        select exception_id, factory_id, exception_code, exception_type, status, responsible_party,
               workorder_id, workorder_code, workorder_name, task_id, task_code,
               process_id, process_code, process_name, target_type, target_id, target_code,
               reporter_id, reporter_name, occur_time, impact_quantity, description, scene_images,
               quality_subclass, usable_quantity, need_rework,
               item_id, item_code, item_name, shortage_quantity, expected_arrival_date,
               original_plan_time, new_expected_time, delay_reason,
               return_quantity, return_reason, customer_accept_rework,
               conclusion, resolve_type, resolve_by, resolve_time,
               target_doc_type, target_doc_id, target_doc_code, scrap_quantity,
               close_by, close_time, remark, create_by, create_time, update_by, update_time
        from qxx_pro_exception
    </sql>

    <select id="selectProExceptionList" parameterType="com.ruoyi.system.domain.mes.pro.ProException"
            resultMap="ProExceptionResult">
        <include refid="selectProExceptionVo"/>
        <where>
            <if test="exceptionCode != null and exceptionCode != ''"> and exception_code like concat('%', #{exceptionCode}, '%')</if>
            <if test="exceptionType != null and exceptionType != ''"> and exception_type = #{exceptionType}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="responsibleParty != null and responsibleParty != ''"> and responsible_party = #{responsibleParty}</if>
            <if test="workorderId != null"> and workorder_id = #{workorderId}</if>
            <if test="workorderCode != null and workorderCode != ''"> and workorder_code like concat('%', #{workorderCode}, '%')</if>
            <if test="taskId != null"> and task_id = #{taskId}</if>
            <if test="processId != null"> and process_id = #{processId}</if>
            <if test="resolveType != null and resolveType != ''"> and resolve_type = #{resolveType}</if>
            <if test="params.beginOccurTime != null and params.beginOccurTime != ''">
                and date_format(occur_time,'%Y%m%d') &gt;= date_format(#{params.beginOccurTime},'%Y%m%d')
            </if>
            <if test="params.endOccurTime != null and params.endOccurTime != ''">
                and date_format(occur_time,'%Y%m%d') &lt;= date_format(#{params.endOccurTime},'%Y%m%d')
            </if>
        </where>
        order by exception_id desc
    </select>

    <select id="selectProExceptionByExceptionId" parameterType="Long" resultMap="ProExceptionResult">
        <include refid="selectProExceptionVo"/>
        where exception_id = #{exceptionId}
    </select>

