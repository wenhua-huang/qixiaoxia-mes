               issue_total_qty, recpt_total_qty, operator, issue_time,
               vendor_receive_time, vendor_receiver, finish_time, finish_by, ship_time, ship_by,
               receive_time,
               remark, create_by, create_time, update_by, update_time
        from qxx_wm_outsource_order
    </sql>

    <!-- 列表带 qc_status 计算列：对外协单全部 IQC 单状态汇总（最差优先，
         口径与 WmItemRecptMapper 一致：任一 FAIL→FAILED；CONCESSION→CONCESSION；
         存在 PENDING/INSPECTING→PENDING；全 PASS→PASSED；无单→NONE）。 -->
    <select id="selectOutsourceOrderList" parameterType="com.ruoyi.system.domain.mes.wm.WmOutsourceOrder" resultMap="WmOutsourceOrderResult">
        select t.order_id, t.factory_id, t.outsource_factory_id, t.order_code, t.vendor_id, t.vendor_code, t.vendor_name,
               t.workorder_id, t.workorder_code, t.card_id, t.route_id, t.process_id, t.process_code, t.process_name,
               t.source_type, t.source_ref_id, t.status, t.feedback_id, t.iqc_id, t.iqc_code,
               t.issue_total_qty, t.recpt_total_qty, t.operator, t.issue_time,
               t.vendor_receive_time, t.vendor_receiver, t.finish_time, t.finish_by, t.ship_time, t.ship_by,
               t.receive_time, t.remark, t.create_by, t.create_time, t.update_by, t.update_time,
               (
                   select case
                       when max(case when i.status = 'COMPLETED' and i.check_result = 'FAIL' then 1 else 0 end) = 1 then 'FAILED'
                       when max(case when i.status = 'COMPLETED' and i.check_result = 'CONCESSION' then 1 else 0 end) = 1 then 'CONCESSION'
                       when max(case when i.status in ('PENDING', 'INSPECTING') then 1 else 0 end) = 1 then 'PENDING'
                       when max(case when i.status = 'COMPLETED' and i.check_result = 'PASS' then 1 else 0 end) = 1 then 'PASSED'
                       else 'NONE'
                   end
                   from qxx_qc_iqc i
                   where i.source_doc_type = 'wm_outsource_order'
                     and i.source_doc_id = t.order_id
                     and i.factory_id = t.factory_id
               ) as qc_status
        from qxx_wm_outsource_order t
        <where>
            t.order_id is not null
            <if test="orderCode != null and orderCode != ''"> and order_code like concat('%', #{orderCode}, '%')</if>
            <if test="vendorId != null"> and vendor_id = #{vendorId}</if>
            <if test="vendorName != null and vendorName != ''"> and vendor_name like concat('%', #{vendorName}, '%')</if>
            <if test="workorderId != null"> and workorder_id = #{workorderId}</if>
            <if test="workorderCode != null and workorderCode != ''"> and workorder_code like concat('%', #{workorderCode}, '%')</if>
            <if test="processId != null"> and process_id = #{processId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="statusList != null and statusList.size() > 0">
                and status in
                <foreach collection="statusList" item="s" open="(" separator="," close=")">#{s}</foreach>
            </if>
            <if test="sourceType != null and sourceType != ''"> and source_type = #{sourceType}</if>
            <if test="cardId != null"> and card_id = #{cardId}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectByWorkorderId" parameterType="Long" resultMap="WmOutsourceOrderResult">
        <include refid="selectVo"/>
        where workorder_id = #{workorderId}
        order by order_id desc
    </select>

    <select id="selectOutsourceOrderByOrderId" parameterType="Long" resultMap="WmOutsourceOrderResult">
