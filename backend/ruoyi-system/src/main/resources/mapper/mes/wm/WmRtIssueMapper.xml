    <delete id="deleteWmRtIssueByRtIds">
        delete from qxx_wm_rt_issue where rt_id in
        <foreach item="rtId" collection="array" open="(" separator="," close=")">
            #{rtId}
        </foreach>
    </delete>

    <update id="updateRtIssueHeaderRefs">
        update qxx_wm_rt_issue
        set rqc_id = #{rqcId}, rqc_code = #{rqcCode}
        where rt_id = #{rtId} and rqc_id is null
    </update>
