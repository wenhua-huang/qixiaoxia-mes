<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.mes.ai.AiChatMessageMapper">

    <resultMap type="com.ruoyi.system.domain.mes.ai.AiChatMessage" id="AiChatMessageResult">
        <result property="msgId"      column="msg_id"/>
        <result property="factoryId"  column="factory_id"/>
        <result property="sessionId"  column="session_id"/>
        <result property="userId"     column="user_id"/>
        <result property="role"       column="role"/>
        <result property="content"    column="content"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectMessageVo">
        select msg_id, factory_id, session_id, user_id, role, content, create_time
        from qxx_sys_ai_chat_message
    </sql>

    <select id="selectMessagesBySessionId" parameterType="java.lang.Long" resultMap="AiChatMessageResult">
        <include refid="selectMessageVo"/>
        where session_id = #{sessionId}
        order by msg_id asc
    </select>

    <select id="selectRecentMessages" resultMap="AiChatMessageResult">
        <include refid="selectMessageVo"/>
        where session_id = #{sessionId}
        order by msg_id desc
        limit #{limit}
    </select>

    <!-- @SkipFactoryId：异步线程无请求上下文，factory_id 由 Service 显式赋值 -->
    <insert id="insertMessage" parameterType="com.ruoyi.system.domain.mes.ai.AiChatMessage"
            useGeneratedKeys="true" keyProperty="msgId">
        insert into qxx_sys_ai_chat_message (factory_id, session_id, user_id, role, content, create_time)
        values (#{factoryId}, #{sessionId}, #{userId}, #{role}, #{content}, #{createTime})
    </insert>
</mapper>
