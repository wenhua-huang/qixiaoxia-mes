.env.local
.env.*.local
*.env
!.env.example

# --- Docker ---
docker-data/

# --- Claude Code ---
# .claude/ 纳入版本控制，但排除临时 worktree
.claude/worktrees/

# --- ZCode ---
.zcode/

# --- Logs ---
*.log
logs/
frontend/logs/
backend/logs/

# --- E2E ---
e2e/test-results/
