<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.mes.pro.ProFeedbackChangeMapper">

    <resultMap type="ProFeedbackChange" id="ProFeedbackChangeResult">
        <result property="changeId"      column="change_id"      />
        <result property="factoryId"     column="factory_id"     />
        <result property="feedbackId"    column="feedback_id"    />
        <result property="taskId"        column="task_id"        />
        <result property="workorderId"   column="workorder_id"   />
        <result property="fieldName"     column="field_name"     />
        <result property="oldValue"      column="old_value"      />
        <result property="newValue"      column="new_value"      />
        <result property="changeSource"  column="change_source"  />
        <result property="changeReason"  column="change_reason"  />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectProFeedbackChangeVo">
        select change_id, factory_id, feedback_id, task_id, workorder_id, field_name, old_value, new_value,
               change_source, change_reason, create_by, create_time
        from qxx_pro_feedback_change
    </sql>

    <!-- 单 @Param 方法没有 factoryId 形参；factory_id 由 FactoryIdInterceptor 自动注入 SQL 文本 -->
    <select id="selectByFeedback" resultMap="ProFeedbackChangeResult">
        <include refid="selectProFeedbackChangeVo"/>
        where feedback_id = #{feedbackId}
        order by create_time desc, change_id desc
    </select>

    <select id="selectByTask" resultMap="ProFeedbackChangeResult">
        <include refid="selectProFeedbackChangeVo"/>
        where task_id = #{taskId}
        order by create_time desc, change_id desc
    </select>

    <!-- factory_id 由 FactoryIdInterceptor 自动注入（业务 INSERT 不写 factory_id） -->
    <insert id="insertProFeedbackChange" parameterType="ProFeedbackChange" useGeneratedKeys="true" keyProperty="changeId">
        insert into qxx_pro_feedback_change
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="feedbackId != null">feedback_id,</if>
            <if test="taskId != null">task_id,</if>
            <if test="workorderId != null">workorder_id,</if>
            <if test="fieldName != null">field_name,</if>
            <if test="oldValue != null">old_value,</if>
            <if test="newValue != null">new_value,</if>
            <if test="changeSource != null">change_source,</if>
            <if test="changeReason != null">change_reason,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="feedbackId != null">#{feedbackId},</if>
            <if test="taskId != null">#{taskId},</if>
            <if test="workorderId != null">#{workorderId},</if>
            <if test="fieldName != null">#{fieldName},</if>
            <if test="oldValue != null">#{oldValue},</if>
            <if test="newValue != null">#{newValue},</if>
            <if test="changeSource != null">#{changeSource},</if>
            <if test="changeReason != null">#{changeReason},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>
</mapper>
