<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.mes.wm.WmProductRecptMapper">

    <resultMap type="WmProductRecpt" id="WmProductRecptResult">
        <id property="recptId" column="recpt_id" />
        <result property="factoryId" column="factory_id" />
        <result property="recptCode" column="recpt_code" />
        <result property="recptName" column="recpt_name" />
        <result property="produceId" column="produce_id" />
        <result property="produceCode" column="produce_code" />
        <result property="workorderId" column="workorder_id" />
        <result property="workorderCode" column="workorder_code" />
        <result property="clientId" column="client_id" />
        <result property="clientName" column="client_name" />
        <result property="sourceWarehouseId" column="source_warehouse_id" />
        <result property="warehouseId" column="warehouse_id" />
        <result property="warehouseCode" column="warehouse_code" />
        <result property="warehouseName" column="warehouse_name" />
        <result property="recptDate" column="recpt_date" />
        <result property="totalQuantity" column="total_quantity" />
        <result property="totalBox" column="total_box" />
        <result property="ipqcId" column="ipqc_id" />
        <result property="ipqcCode" column="ipqc_code" />
        <result property="status" column="status" />
        <result property="remark" column="remark" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectWmProductRecptVo">
        select t.recpt_id, t.factory_id, t.recpt_code, t.recpt_name, t.produce_id, t.produce_code,
               t.workorder_id, t.workorder_code, t.client_id, t.source_warehouse_id, t.warehouse_id,
               t.warehouse_code, t.warehouse_name, t.recpt_date, t.total_quantity, t.total_box,
               t.ipqc_id, t.ipqc_code, t.status, t.remark, t.create_by, t.create_time, t.update_by, t.update_time,
               c.client_name
        from qxx_wm_product_recpt t
        left join qxx_md_client c on c.client_id = t.client_id and c.factory_id = t.factory_id
    </sql>

    <select id="selectWmProductRecptList" parameterType="WmProductRecpt" resultMap="WmProductRecptResult">
        <include refid="selectWmProductRecptVo"/>
        <where>
            <if test="recptCode != null and recptCode != ''"> and t.recpt_code like concat('%', #{recptCode}, '%')</if>
            <if test="recptName != null and recptName != ''"> and t.recpt_name like concat('%', #{recptName}, '%')</if>
            <if test="produceId != null"> and t.produce_id = #{produceId}</if>
            <if test="produceCode != null and produceCode != ''"> and t.produce_code like concat('%', #{produceCode}, '%')</if>
            <if test="workorderId != null"> and t.workorder_id = #{workorderId}</if>
            <if test="workorderCode != null and workorderCode != ''"> and t.workorder_code like concat('%', #{workorderCode}, '%')</if>
            <if test="sourceWarehouseId != null"> and t.source_warehouse_id = #{sourceWarehouseId}</if>
            <if test="warehouseId != null"> and t.warehouse_id = #{warehouseId}</if>
            <if test="warehouseCode != null and warehouseCode != ''"> and t.warehouse_code like concat('%', #{warehouseCode}, '%')</if>
            <if test="warehouseName != null and warehouseName != ''"> and t.warehouse_name like concat('%', #{warehouseName}, '%')</if>
            <if test="ipqcId != null"> and t.ipqc_id = #{ipqcId}</if>
            <if test="ipqcCode != null and ipqcCode != ''"> and t.ipqc_code like concat('%', #{ipqcCode}, '%')</if>
            <if test="status != null and status != ''"> and t.status like concat('%', #{status}, '%')</if>
            <if test="createBy != null and createBy != ''"> and t.create_by like concat('%', #{createBy}, '%')</if>
            <if test="updateBy != null and updateBy != ''"> and t.update_by like concat('%', #{updateBy}, '%')</if>
        </where>
        order by t.create_time desc
    </select>

    <select id="selectWmProductRecptAll" resultMap="WmProductRecptResult">
        <include refid="selectWmProductRecptVo"/>
    </select>

    <select id="selectWmProductRecptByRecptId" parameterType="Long" resultMap="WmProductRecptResult">
        <include refid="selectWmProductRecptVo"/>
        where t.recpt_id = #{recptId}
    </select>

    <insert id="insertWmProductRecpt" parameterType="WmProductRecpt" useGeneratedKeys="true" keyProperty="recptId">
        insert into qxx_wm_product_recpt
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recptCode != null">recpt_code,</if>
            <if test="recptName != null">recpt_name,</if>
            <if test="produceId != null">produce_id,</if>
            <if test="produceCode != null">produce_code,</if>
            <if test="workorderId != null">workorder_id,</if>
            <if test="workorderCode != null">workorder_code,</if>
            <if test="clientId != null">client_id,</if>
            <if test="sourceWarehouseId != null">source_warehouse_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="warehouseCode != null">warehouse_code,</if>
            <if test="warehouseName != null">warehouse_name,</if>
            <if test="recptDate != null">recpt_date,</if>
            <if test="totalQuantity != null">total_quantity,</if>
            <if test="totalBox != null">total_box,</if>
            <if test="ipqcId != null">ipqc_id,</if>
            <if test="ipqcCode != null">ipqc_code,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="recptCode != null">#{recptCode},</if>
            <if test="recptName != null">#{recptName},</if>
            <if test="produceId != null">#{produceId},</if>
            <if test="produceCode != null">#{produceCode},</if>
            <if test="workorderId != null">#{workorderId},</if>
            <if test="workorderCode != null">#{workorderCode},</if>
            <if test="clientId != null">#{clientId},</if>
            <if test="sourceWarehouseId != null">#{sourceWarehouseId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="warehouseCode != null">#{warehouseCode},</if>
            <if test="warehouseName != null">#{warehouseName},</if>
            <if test="recptDate != null">#{recptDate},</if>
            <if test="totalQuantity != null">#{totalQuantity},</if>
            <if test="totalBox != null">#{totalBox},</if>
            <if test="ipqcId != null">#{ipqcId},</if>
            <if test="ipqcCode != null">#{ipqcCode},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateWmProductRecpt" parameterType="WmProductRecpt">
        update qxx_wm_product_recpt
        <trim prefix="SET" suffixOverrides=",">
            <if test="recptCode != null">recpt_code = #{recptCode},</if>
            <if test="recptName != null">recpt_name = #{recptName},</if>
            <if test="produceId != null">produce_id = #{produceId},</if>
            <if test="produceCode != null">produce_code = #{produceCode},</if>
            <if test="workorderId != null">workorder_id = #{workorderId},</if>
            <if test="workorderCode != null">workorder_code = #{workorderCode},</if>
            <if test="clientId != null">client_id = #{clientId},</if>
            <if test="sourceWarehouseId != null">source_warehouse_id = #{sourceWarehouseId},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="warehouseCode != null">warehouse_code = #{warehouseCode},</if>
            <if test="warehouseName != null">warehouse_name = #{warehouseName},</if>
            <if test="recptDate != null">recpt_date = #{recptDate},</if>
            <if test="totalQuantity != null">total_quantity = #{totalQuantity},</if>
            <if test="totalBox != null">total_box = #{totalBox},</if>
            <if test="ipqcId != null">ipqc_id = #{ipqcId},</if>
            <if test="ipqcCode != null">ipqc_code = #{ipqcCode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where recpt_id = #{recptId}
    </update>

    <delete id="deleteWmProductRecptByRecptId" parameterType="Long">
        delete from qxx_wm_product_recpt where recpt_id = #{recptId}
    </delete>

    <delete id="deleteWmProductRecptByRecptIds" parameterType="String">
        delete from qxx_wm_product_recpt where recpt_id in
        <foreach item="recptId" collection="array" open="(" separator="," close=")">
            #{recptId}
        </foreach>
    </delete>

    <!--
      汇总某工单已生成的入库单总量。
      语义：仅统计 DRAFT/CONFIRMED/POSTED 三种业务状态；status IS NULL 视为脏数据不计入。
      状态机：DRAFT → CONFIRMED (库存已扣) → POSTED (已过账)。
      factory_id 由 FactoryIdInterceptor 自动注入。
      用途：手动补录 (generateProductReceipt) 计算未入库差额。
      注意：DRAFT/CONFIRMED 已产生 doc log 记录，必须计入差额基数，否则会被重复"补录"。
    -->
    <select id="sumQuantityByWorkorderId" resultType="java.math.BigDecimal">
        select COALESCE(SUM(total_quantity), 0)
        from qxx_wm_product_recpt
        where workorder_id = #{workorderId}
          and status in ('DRAFT', 'CONFIRMED', 'POSTED')
    </select>

</mapper>
